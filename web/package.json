{
  "name": "@diploma/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node ../scripts/prepare-web.mjs",
    "start": "node .next/standalone/web/server.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
