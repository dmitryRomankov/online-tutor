{
  "name": "diploma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One-to-one online lesson platform",
  "workspaces": [
    "web",
    "api"
  ],
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @diploma/web",
    "dev:api": "npm run dev --workspace @diploma/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:smoke": "node scripts/smoke.mjs",
    "test:auth:integration": "node scripts/database/test.mjs --auth",
    "test:e2e": "node scripts/smoke.mjs --e2e",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "npm run db:generate --workspace @diploma/api",
    "db:validate": "npm run db:validate --workspace @diploma/api",
    "db:migrate": "npm run db:deploy",
    "db:studio": "npm run db:studio --workspace @diploma/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:deploy": "npm run db:deploy --workspace @diploma/api",
    "db:bootstrap": "node scripts/database/bootstrap.mjs",
    "db:seed:reference": "node scripts/database/reference-seed.mjs",
    "db:seed:demo": "node scripts/database/demo-seed.mjs",
    "db:test": "node scripts/database/test.mjs",
    "db:docs": "node scripts/database/docs.mjs",
    "db:cleanup:auth": "node scripts/database/cleanup-auth.mjs"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "cypress": "16.2.0"
  }
}
