// SQL migrations own checks, views, triggers, expression and partial indexes.
// Partial uniqueness does not make historical collections one-to-one.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["private", "public", "reporting"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model task_choice_keys {
  input_id           String             @db.Uuid
  choice_id          String             @db.Uuid
  expected_position  Int?
  task_input_choices task_input_choices @relation(fields: [input_id, choice_id], references: [input_id, choice_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([input_id, choice_id])
  @@index([choice_id], map: "task_choice_keys_choice_idx")
  @@schema("private")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model task_text_keys {
  input_id      String      @db.Uuid
  variant_no    Int
  accepted_text String
  task_inputs   task_inputs @relation(fields: [input_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([input_id, variant_no])
  @@schema("private")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_credentials {
  user_id       String @id @db.Uuid
  password_hash String
  users         users  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("private")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assets {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id      String          @db.Uuid
  object_key    String          @unique
  media_type    String
  byte_size     BigInt
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  users         users           @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lesson_items  lesson_items[]
  task_versions task_versions[]

  @@index([owner_id], map: "assets_owner_idx")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model chat_messages {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id        String   @db.Uuid
  sender_id         String   @db.Uuid
  client_message_id String   @db.Uuid
  body              String
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  users             users    @relation(fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions          sessions @relation(fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([session_id, sender_id, client_message_id])
  @@index([session_id, created_at, id], map: "chat_messages_order_idx")
  @@index([sender_id], map: "chat_messages_sender_idx")
  @@schema("public")
}

