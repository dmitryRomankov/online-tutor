  tutor_invitations_tutor_invitations_tutor_idTousers            tutor_invitations[] @relation("tutor_invitations_tutor_idTousers")
  tutor_students_tutor_students_student_idTousers                tutor_students[]    @relation("tutor_students_student_idTousers")
  tutor_students_tutor_students_tutor_idTousers                  tutor_students[]    @relation("tutor_students_tutor_idTousers")
  roles                                                          roles               @relation(fields: [role_code], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

model auth_sessions {
  sid String @id @db.VarChar
  sess Json @db.Json
  expire DateTime @db.Timestamptz(6)

  @@index([expire], map: "auth_sessions_expire_idx")
  @@schema("private")
}

model auth_rate_limits {
  key_hash String @id @db.VarChar(64)
  attempts Int
  expires_at DateTime @db.Timestamptz(6)

  @@index([expires_at], map: "auth_rate_limits_expiry_idx")
  @@schema("private")
}
