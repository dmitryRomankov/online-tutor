NODE_ENV=
PORT=
HOST=
CLIENT_ORIGIN=
# Runtime must use tutor_app; replace placeholders with URL-encoded secrets after bootstrap.
DATABASE_URL=
# Direct connection for runtime-role maintenance tools, when required.
DATABASE_URL_UNPOOLED=
# Direct connection as tutor_migrator, separate from the pooled runtime URL.
MIGRATION_DATABASE_URL=
# Administrator connection is for explicit provisioning only; never use in the running API.
ADMIN_DATABASE_URL=
MIGRATOR_PASSWORD=
APP_PASSWORD=
REPORTER_PASSWORD=
REPORTING_DATABASE_URL=
DEMO_PASSWORD=
# Authentication uses DATABASE_URL (PostgreSQL sessions) and a random signing secret of at least 32 characters.
SESSION_SECRET=
# Absolute session lifetime in seconds (default 8 hours, maximum 7 days).
AUTH_SESSION_TTL_SECONDS=28800
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Vercel Blob private store. Vercel supplies VERCEL_OIDC_TOKEN when OIDC is enabled.
BLOB_STORE_ID=
# Optional server-only token for local development with a separate store.
BLOB_READ_WRITE_TOKEN=
