{
  "name": "@diploma/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "npm run db:generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" prisma.config.ts --max-warnings 0",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@azure/storage-blob": "12.34.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/websockets": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "connect-redis": "10.0.0",
    "dotenv": "18.0.9",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "livekit-server-sdk": "2.19.2",
    "pg": "8.23.1",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
