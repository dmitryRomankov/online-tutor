{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "api",
      "framework": "node",
      "entrypoint": "vercel.mjs",
      "buildCommand": "npm run build:vercel",
      "outputDirectory": "vercel-output",
      "devCommand": "npm run dev"
    },
    "web": {
      "root": "web",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "INTERNAL_API_URL" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": { "service": "web" }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
